<!DOCTYPE html>
<html lang="th">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="color-scheme" content="light dark">
<title>CHS AI</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Prompt:wght@400;500;700&display=swap" rel="stylesheet">
<style>
/* ===== สี/ธีม: แก้ที่นี่ที่เดียว ===== */
:root{
  --c1:#06243f; --c2:#17406b;           /* น้ำเงินเข้ม / น้ำเงินกลาง (จากดีไซน์) */
  --bg:#fff; --ink:#06243f;             /* พื้นหลัง / ตัวอักษร */
  --card:#06243f; --card-ink:#fff; --card-line:#17406b;
  --side:#06243f; --side-box:#17406b;
  --btn:#06243f; --btn-ink:#fff; --field:#17406b;
  --danger:#e5202e; color-scheme:light;
}
@media (prefers-color-scheme:dark){
  :root:not([data-theme="light"]){
    --bg:#06243f; --ink:#fff;
    --card:#17406b; --card-line:#06243f;
    --side:#17406b; --side-box:#06243f;
    --btn:#17406b; --field:#06243f; color-scheme:dark;
  }
}
:root[data-theme="dark"]{
  --bg:#06243f; --ink:#fff; --card:#17406b; --card-line:#06243f;
  --side:#17406b; --side-box:#06243f; --btn:#17406b; --field:#06243f; color-scheme:dark;
}
*{box-sizing:border-box;margin:0}
html,body{height:100%}
body{font-family:"Prompt",system-ui,sans-serif;background:var(--bg);color:var(--ink);
  padding:env(safe-area-inset-top,0) env(safe-area-inset-right,0) env(safe-area-inset-bottom,0) env(safe-area-inset-left,0);
  overflow:hidden}
button,input,select{font:inherit;color:inherit}
button{cursor:pointer;border:0;background:none}
:focus-visible{outline:2px solid currentColor;outline-offset:2px}
[hidden]{display:none!important}
.screen{position:fixed;inset:0;display:flex;flex-direction:column;background:var(--bg);
  padding:env(safe-area-inset-top,0) 0 env(safe-area-inset-bottom,0)}
.app{max-width:520px;margin:0 auto;width:100%;height:100%;display:flex;flex-direction:column;position:relative}
.round{width:46px;height:46px;border-radius:50%;background:var(--card);color:var(--card-ink);display:grid;place-items:center;flex:none}
.round svg{width:24px;height:24px}
svg{fill:none;stroke:currentColor;stroke-width:2.2;stroke-linecap:round;stroke-linejoin:round}

/* ===== แชต ===== */
.top{display:flex;align-items:flex-start;justify-content:space-between;padding:18px 24px 0}
.badge{background:var(--card);color:var(--card-ink);font-size:12px;font-weight:700;padding:8px 14px;border-radius:20px;border:3px solid var(--card-line)}
.logo{width:116px;height:116px;display:block;margin:-6px auto 0}
.hero{text-align:center;padding:12px 24px}
.hero h1{font-size:24px;font-weight:700;margin-top:28px}
.hero p{margin-top:8px;font-size:15px}
.feed{flex:1;overflow:auto;padding:12px 20px;display:flex;flex-direction:column;gap:10px}
.msg{max-width:85%;padding:10px 14px;border-radius:18px;line-height:1.5;white-space:pre-wrap;word-break:break-word}
.msg.me{align-self:flex-end;background:var(--card);color:var(--card-ink);border-bottom-right-radius:4px}
.msg.ai{align-self:flex-start;background:var(--field);color:#fff;border-bottom-left-radius:4px}
.composer{margin:12px 24px 22px;display:flex;gap:8px;align-items:center;background:var(--card);border:3px solid var(--card-line);border-radius:30px;padding:6px}
.composer input{flex:1;min-width:0;background:var(--field);color:#fff;border:0;border-radius:24px;padding:11px 16px;outline-offset:0}
.composer input::placeholder{color:#fffa}
.send{width:38px;height:38px;border-radius:50%;background:#fff;color:var(--c1);display:grid;place-items:center;flex:none}
.send:disabled{opacity:.5}

/* ===== เมนูข้าง ===== */
.drawer{position:fixed;inset:0;z-index:20;display:flex}
.drawer .panel{width:min(76vw,320px);background:var(--side);color:#fff;display:flex;flex-direction:column;padding:calc(20px + env(safe-area-inset-top,0)) 12px calc(18px + env(safe-area-inset-bottom,0)) 12px}
.drawer .scrim{flex:1;background:#0006}
.brand{display:flex;align-items:center;gap:10px;padding:0 10px 14px;font-weight:700;font-size:22px}
.brand .logo{width:42px;height:42px;margin:0}
.nav{background:var(--side-box);border-radius:22px;padding:12px 14px;display:flex;flex-direction:column;gap:10px}
.nav button{text-align:left;color:#fff}
.recents{margin:46px 14px 0;flex:1;overflow:auto}
.recents h3{font-size:16px;font-weight:400;margin-bottom:10px}
.recents button{display:block;width:100%;text-align:left;color:#fff;padding:6px 0;opacity:.9;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.acct{display:flex;align-items:center;gap:12px;background:var(--side-box);border-radius:30px;padding:6px 14px 6px 6px;color:#fff;font-size:18px}
.avatar{width:46px;height:46px;border-radius:50%;background:#fff;color:var(--c1);display:grid;place-items:center;flex:none}
.avatar svg{width:26px;height:26px;fill:currentColor;stroke:none}

/* ===== ตั้งค่า ===== */
.head{display:flex;align-items:center;justify-content:space-between;padding:18px 24px}
.head h2{font-size:20px;font-weight:700}
.head .x{width:42px;height:42px;display:grid;place-items:center;border-radius:50%}
html[data-sets] .x{}
.stack{padding:6px 28px;display:flex;flex-direction:column;gap:30px;overflow:auto}
.box{background:var(--card);color:var(--card-ink);border-radius:22px;padding:6px 16px}
.row{display:flex;align-items:center;gap:12px;width:100%;padding:13px 0;text-align:left;color:inherit}
.row+.row{border-top:3px solid var(--card-line)}
.row svg{width:24px;height:24px;flex:none}
.row .grow{flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis}
.row.danger{color:var(--danger)}
.sub{padding:6px 28px;display:flex;flex-direction:column;gap:14px}
.sub label{display:flex;justify-content:space-between;align-items:center;gap:12px}
.seg{display:flex;gap:6px;flex-wrap:wrap}
.seg button{padding:8px 16px;border-radius:18px;background:var(--field);color:#fff;border:2px solid transparent}
.seg button[aria-pressed="true"]{border-color:#fff;font-weight:700}
.note{font-size:13px;opacity:.75}

/* ===== เข้าสู่ระบบ ===== */
.login{justify-content:center;align-items:center;padding:24px}
.login form{width:100%;max-width:380px;display:flex;flex-direction:column;gap:12px;text-align:center}
.login .logo{margin:0 auto 6px}
.login h1{font-size:24px}
.in{width:100%;padding:13px 16px;border-radius:16px;border:3px solid var(--card-line);background:var(--card);color:#fff;outline-offset:2px}
.in::placeholder{color:#fff9}
.cta{padding:13px;border-radius:24px;background:var(--btn);color:var(--btn-ink);font-weight:700;border:3px solid var(--card-line)}
.link{text-decoration:underline;font-size:14px}
.err{color:var(--danger);font-size:14px;min-height:20px}
</style>
</head>
<body>

<!-- ============ เข้าสู่ระบบ ============ -->
<main class="screen login" id="s-login" hidden>
  <form id="f-login" novalidate>
    <svg class="logo" data-logo viewBox="0 0 100 100"></svg>
    <h1 id="t-login">เข้าสู่ระบบ CHS AI</h1>
    <p class="note" id="t-hint">ใช้อีเมลโรงเรียน @chs.ac.th เท่านั้น</p>
    <input class="in" id="email" type="email" inputmode="email" autocomplete="username" placeholder="ชื่อ@chs.ac.th" required>
    <input class="in" id="pass" type="password" autocomplete="current-password" placeholder="รหัสผ่าน (อย่างน้อย 6 ตัว)" required>
    <select class="in" id="role"><option value="Student">Student</option><option value="Teacher">Teacher</option></select>
    <div class="err" id="err" role="alert"></div>
    <button class="cta" type="submit" id="go">เข้าสู่ระบบ</button>
    <button class="link" type="button" id="toggle">ยังไม่มีบัญชี? สมัครใช้งาน</button>
    <button class="link" type="button" id="cancel" hidden>ยกเลิก</button>
  </form>
</main>

<!-- ============ แชต ============ -->
<main class="screen" id="s-chat" hidden>
  <div class="app">
    <div class="top">
      <button class="round" id="open-menu" aria-label="เมนู"><svg viewBox="0 0 24 24"><path d="M4 7h16M8 12h8M10 17h4"/></svg></button>
      <div class="badge" id="role-badge">Teacher / Student</div>
    </div>
    <div class="hero" id="hero">
      <svg class="logo" data-logo viewBox="0 0 100 100"></svg>
      <h1 id="t-h1"></h1><p id="t-sub"></p>
    </div>
    <div class="feed" id="feed" hidden aria-live="polite"></div>
    <div style="flex:1" id="spacer"></div>
    <form class="composer" id="f-chat">
      <input id="q" autocomplete="off" aria-label="ถามคำถาม">
      <button class="send" id="send" aria-label="ส่ง"><svg viewBox="0 0 24 24"><path d="M12 19V5M5 12l7-7 7 7"/></svg></button>
    </form>
  </div>
  <div class="drawer" id="drawer" hidden>
    <aside class="panel">
      <div class="brand"><svg class="logo" data-logo viewBox="0 0 100 100"></svg>CHS AI</div>
      <div class="nav">
        <button data-act="new" id="t-new">New chat</button>
        <button data-act="manual" id="t-manual">User Manual</button>
        <button data-act="more" aria-label="เพิ่มเติม">…</button>
      </div>
      <div class="recents"><h3>Recents</h3><div id="recents"></div></div>
      <button class="acct" data-act="settings"><span class="avatar"><svg viewBox="0 0 24 24"><circle cx="12" cy="8" r="4.5"/><path d="M3.5 21c0-4.6 3.8-7 8.5-7s8.5 2.4 8.5 7z"/></svg></span>My Account</button>
    </aside>
    <div class="scrim" data-act="close"></div>
  </div>
</main>

<!-- ============ ตั้งค่า ============ -->
<section class="screen" id="s-set" hidden>
  <div class="app">
    <div class="head">
      <button class="round" id="set-close" aria-label="ปิด"><svg viewBox="0 0 24 24"><path d="M5 5l14 14M19 5L5 19"/></svg></button>
      <h2 id="set-title">Settings</h2>
      <button class="round" id="set-info" aria-label="ข้อมูล"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M12 11v6M12 7.5v.01"/></svg></button>
    </div>
    <div id="set-body"></div>
  </div>
</section>

<script>
/* =====================================================
   CONFIG — ส่วนที่ปรับได้ง่าย (ข้อความ, โดเมน, โลโก้)
   ===================================================== */
const CONFIG = {
  allowedDomain: "chs.ac.th",
  logoUrl: "data:image/png;base64,",   // โลโก้โรงเรียน (ฝังในไฟล์แล้ว) — เปลี่ยนเป็น path/URL อื่นได้
  strings: {
    h1: "วันนี้คุณอยากรู้ ข้อมูลอะไร ?",
    sub: "สอบถามข้อมูลทางวิชาการของโรงเรียนเฉลิมขวัญสตรี",
    placeholder: "ASk CHS AI",
    thinking: "กำลังค้นหาข้อมูล…",
    badDomain: "ใช้ได้เฉพาะอีเมล @chs.ac.th เท่านั้น",
    short: "รหัสผ่านต้องมีอย่างน้อย 6 ตัวอักษร",
    wrong: "อีเมลหรือรหัสผ่านไม่ถูกต้อง",
    exists: "อีเมลนี้สมัครแล้ว กรุณาเข้าสู่ระบบ",
    manual: "คู่มือการใช้งาน: พิมพ์คำถามเกี่ยวกับข้อมูลโรงเรียนในช่องด้านล่างแล้วกดส่ง"
  }
};

/* =====================================================
   ADAPTERS — จุดเชื่อมต่อ backend ในอนาคต
   เปลี่ยนแค่สองออบเจ็กต์นี้ โดยไม่ต้องแตะ UI
   ===================================================== */
const store = {
  get(k, d){ try{ const v = localStorage.getItem(k); return v ? JSON.parse(v) : d; }catch{ return d; } },
  set(k, v){ try{ localStorage.setItem(k, JSON.stringify(v)); }catch{} }
};
const isSchoolEmail = e => new RegExp("^[^\\s@]+@" + CONFIG.allowedDomain.replace(/\./g,"\\.") + "$","i").test(e.trim());

/* ระบบล็อกอินตัวอย่าง (เก็บในเบราว์เซอร์เท่านั้น — ใช้ทดสอบหน้าตา)
   ของจริงต้องเปลี่ยนเป็น Firebase / Supabase / API ของโรงเรียน
   และต้องตรวจโดเมน @chs.ac.th ที่ฝั่งเซิร์ฟเวอร์อีกชั้นเสมอ */
const authAdapter = {
  async hash(s){ const b = await crypto.subtle.digest("SHA-256", new TextEncoder().encode(s)); return [...new Uint8Array(b)].map(x=>x.toString(16).padStart(2,"0")).join(""); },
  async signUp(email, pass, role){
    const users = store.get("chs.users", {}); email = email.trim().toLowerCase();
    if(users[email]) throw new Error(CONFIG.strings.exists);
    users[email] = { h: await this.hash(pass), role }; store.set("chs.users", users);
    return this.start(email, role);
  },
  async signIn(email, pass){
    const users = store.get("chs.users", {}); email = email.trim().toLowerCase();
    const u = users[email];
    if(!u || u.h !== await this.hash(pass)) throw new Error(CONFIG.strings.wrong);
    return this.start(email, u.role);
  },
  start(email, role){
    const s = store.get("chs.session", { list: [], active: null });
    if(!s.list.find(a=>a.email===email)) s.list.push({email, role});
    s.active = email; store.set("chs.session", s); return {email, role};
  },
  switchTo(email){ const s = store.get("chs.session", {list:[],active:null}); s.active = email; store.set("chs.session", s); },
  signOut(){
    const s = store.get("chs.session", {list:[],active:null});
    s.list = s.list.filter(a=>a.email!==s.active); s.active = s.list[0]?.email || null; store.set("chs.session", s);
  },
  current(){ const s = store.get("chs.session", {list:[],active:null}); return s.list.find(a=>a.email===s.active) || null; },
  all(){ return store.get("chs.session", {list:[]}).list; }
};

/* ระบบตอบคำถาม — ตอนนี้เป็นข้อความตัวอย่าง
   ภายหลังเปลี่ยนเป็น fetch ไป API ที่ใช้ข้อมูลโรงเรียน (RAG / ฐานข้อมูล) */
const chatAdapter = {
  async ask(question, history){
    await new Promise(r=>setTimeout(r, 700));
    return "ขณะนี้ระบบยังไม่เชื่อมต่อฐานข้อมูลของโรงเรียน\nคำถามของคุณ: " + question;
  }
};

/* =====================================================
   UI
   ===================================================== */
const $ = id => document.getElementById(id);
const S = CONFIG.strings;
let signupMode = false, adding = false, chats = store.get("chs.chats", []), cur = null;

// โลโก้ชั่วคราว (แทนที่ด้วย CONFIG.logoUrl)
document.querySelectorAll("[data-logo]").forEach(el=>{
  if(CONFIG.logoUrl){
    const img = new Image(); img.src = CONFIG.logoUrl; img.alt = "CHS"; img.className = el.getAttribute("class");
    el.replaceWith(img);
  }else{
    el.innerHTML = '<circle cx="50" cy="50" r="47" fill="#2a1a78" stroke="#8a8f99" stroke-width="3"/><circle cx="50" cy="50" r="30" fill="#cfe3f5"/><path d="M50 28l6 14 14 2-10 10 3 14-13-7-13 7 3-14-10-10 14-2z" fill="#17406b" stroke="none"/>';
  }
});

function show(id){ ["s-login","s-chat","s-set"].forEach(s=>$(s).hidden = s!==id); }
function route(){ authAdapter.current() ? (applyUser(), show("s-chat")) : show("s-login"); }
function applyUser(){ $("role-badge").textContent = authAdapter.current().role; }

/* ----- ธีม: auto = ตามโทรศัพท์ / light / dark ----- */
function setTheme(t){
  if(t==="auto") document.documentElement.removeAttribute("data-theme"); else document.documentElement.dataset.theme = t;
  store.set("chs.theme", t);
  document.querySelector('meta[name="color-scheme"]').content = t==="auto" ? "light dark" : t;
}
setTheme(store.get("chs.theme","auto"));

/* ----- เข้าสู่ระบบ ----- */
function loginMode(){
  $("t-login").textContent = signupMode ? "สมัครใช้งาน CHS AI" : "เข้าสู่ระบบ CHS AI";
  $("go").textContent = signupMode ? "สมัครใช้งาน" : "เข้าสู่ระบบ";
  $("toggle").textContent = signupMode ? "มีบัญชีแล้ว? เข้าสู่ระบบ" : "ยังไม่มีบัญชี? สมัครใช้งาน";
  $("role").hidden = !signupMode; $("err").textContent = "";
  $("pass").autocomplete = signupMode ? "new-password" : "current-password";
  $("cancel").hidden = !adding;
}
$("toggle").onclick = ()=>{ signupMode = !signupMode; loginMode(); };
$("cancel").onclick = ()=>{ adding = false; route(); };
$("f-login").onsubmit = async e=>{
  e.preventDefault();
  const em = $("email").value, pw = $("pass").value;
  if(!isSchoolEmail(em)) return $("err").textContent = S.badDomain;
  if(pw.length < 6) return $("err").textContent = S.short;
  try{
    signupMode ? await authAdapter.signUp(em, pw, $("role").value) : await authAdapter.signIn(em, pw);
    adding = false; $("pass").value = ""; $("err").textContent = ""; newChat(); route();
  }catch(x){ $("err").textContent = x.message; }
};

/* ----- แชต ----- */
$("t-h1").textContent = S.h1; $("t-sub").textContent = S.sub; $("q").placeholder = S.placeholder;
function newChat(){ cur = {id: Date.now(), title: "", msgs: []}; renderChat(); }
function renderChat(){
  const has = cur.msgs.length > 0;
  $("hero").hidden = has; $("feed").hidden = !has; $("spacer").hidden = has;
  $("feed").replaceChildren(...cur.msgs.map(m=>bubble(m.r, m.t)));
  $("feed").scrollTop = 1e9;
}
function bubble(r, t){ const d = document.createElement("div"); d.className = "msg " + r; d.textContent = t; return d; }
function saveChat(){
  if(!cur.title) return;
  chats = [cur, ...chats.filter(c=>c.id!==cur.id)].slice(0,30); store.set("chs.chats", chats);
}
$("f-chat").onsubmit = async e=>{
  e.preventDefault();
  const q = $("q").value.trim(); if(!q) return;
  $("q").value = ""; $("send").disabled = true;
  if(!cur) newChat();
  if(!cur.title) cur.title = q.slice(0,40);
  cur.msgs.push({r:"me", t:q}); renderChat();
  const wait = bubble("ai", S.thinking); $("feed").append(wait); $("feed").scrollTop = 1e9;
  let a; try{ a = await chatAdapter.ask(q, cur.msgs); }catch{ a = "เกิดข้อผิดพลาด ลองใหม่อีกครั้ง"; }
  cur.msgs.push({r:"ai", t:a}); saveChat(); renderChat(); $("send").disabled = false;
};

/* ----- เมนูข้าง ----- */
function openDrawer(){
  $("recents").replaceChildren(...chats.map(c=>{ const b = document.createElement("button"); b.textContent = c.title; b.onclick = ()=>{ cur = c; renderChat(); $("drawer").hidden = true; }; return b; }));
  $("drawer").hidden = false;
}
$("open-menu").onclick = openDrawer;
$("drawer").onclick = e=>{
  const a = e.target.closest("[data-act]")?.dataset.act; if(!a) return;
  if(a==="close") $("drawer").hidden = true;
  if(a==="new"){ newChat(); $("drawer").hidden = true; }
  if(a==="manual"){ cur = {id:Date.now(), title:"", msgs:[{r:"ai", t:S.manual}]}; renderChat(); $("drawer").hidden = true; }
  if(a==="settings"){ $("drawer").hidden = true; openSettings(); }
};

/* ----- ตั้งค่า ----- */
const ic = {
  chev:'<svg viewBox="0 0 24 24" style="width:22px;height:22px"><path d="M9 5l7 7-7 7"/></svg>',
  user:'<span class="avatar" style="width:46px;height:46px;margin-left:-8px"><svg viewBox="0 0 24 24"><circle cx="12" cy="8" r="4.5"/><path d="M3.5 21c0-4.6 3.8-7 8.5-7s8.5 2.4 8.5 7z"/></svg></span>',
  plus:'<svg viewBox="0 0 24 24"><path d="M12 4v16M4 12h16"/></svg>',
  gear:'<svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="3"/><path d="M12 2v3M12 19v3M2 12h3M19 12h3M4.9 4.9l2.1 2.1M17 17l2.1 2.1M4.9 19.1L7 17M17 7l2.1-2.1"/></svg>',
  bell:'<svg viewBox="0 0 24 24"><path d="M6 17V11a6 6 0 0112 0v6l2 2H4zM10 21h4"/></svg>',
  shield:'<svg viewBox="0 0 24 24"><path d="M12 3l8 3v6c0 5-3.5 8-8 9-4.5-1-8-4-8-9V6z"/><path d="M9.5 12.5h5v3.5h-5zM10.5 12.5V11a1.5 1.5 0 013 0v1.5"/></svg>',
  out:'<svg viewBox="0 0 24 24"><path d="M10 4H5v16h5M15 8l4 4-4 4M19 12H9"/></svg>'
};
const row = (icon, text, act, cls="", chev=true) => `<button class="row ${cls}" data-go="${act}">${icon}<span class="grow">${text}</span>${chev?ic.chev:""}</button>`;
const esc = s => s.replace(/[&<>"]/g, c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;"}[c]));
let page = "main";

function openSettings(p="main"){
  page = p; show("s-set");
  const u = authAdapter.current(), body = $("set-body");
  $("set-title").textContent = {main:"Settings", general:"General", notif:"Notifications", sec:"Security and login"}[p];
  if(p==="main"){
    body.innerHTML = `<div class="stack">
      <div class="box">${row(ic.user, esc(u.email), "acct", "", false)}${authAdapter.all().filter(a=>a.email!==u.email).map(a=>row(ic.user, esc(a.email), "sw:"+a.email, "", false)).join("")}${row(ic.plus, "Add account", "add", "", false)}</div>
      <div class="box">${row(ic.gear,"General","general")}${row(ic.bell,"Notifications","notif")}${row(ic.shield,"Security and login","sec")}</div>
      <div class="box">${row(ic.out,"Log out","out","danger",false)}</div></div>`;
  }
  if(p==="general"){
    const t = store.get("chs.theme","auto");
    body.innerHTML = `<div class="sub"><label>ธีม / Theme</label><div class="seg">${[["auto","ตามโทรศัพท์"],["light","สว่าง"],["dark","มืด"]].map(([v,n])=>`<button data-theme="${v}" aria-pressed="${t===v}">${n}</button>`).join("")}</div></div>`;
  }
  if(p==="notif") body.innerHTML = `<div class="sub"><p class="note">ยังไม่มีการตั้งค่าการแจ้งเตือน (เพิ่มได้ภายหลัง)</p></div>`;
  if(p==="sec") body.innerHTML = `<div class="sub"><p>บัญชี: ${esc(u.email)}</p><p class="note">การเปลี่ยนรหัสผ่านจะเพิ่มเมื่อเชื่อมต่อ backend จริง</p></div>`;
}
$("set-body").onclick = e=>{
  const t = e.target.closest("[data-theme]"); if(t){ setTheme(t.dataset.theme); return openSettings("general"); }
  const g = e.target.closest("[data-go]")?.dataset.go; if(!g) return;
  if(g==="out"){ authAdapter.signOut(); cur = null; return route(); }
  if(g==="add"){ adding = true; signupMode = false; loginMode(); return show("s-login"); }
  if(g.startsWith("sw:")){ authAdapter.switchTo(g.slice(3)); newChat(); return route(); }
  if(g!=="acct") openSettings(g);
};
$("set-close").onclick = ()=> page==="main" ? route() : openSettings("main");
$("set-info").onclick = ()=> alert("CHS AI — ผู้ช่วยตอบข้อมูลภายในโรงเรียนเฉลิมขวัญสตรี");

loginMode(); newChat(); route();
</script>
</body>
</html>
